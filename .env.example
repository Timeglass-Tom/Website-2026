# --- Site ------------------------------------------------------------------
# Public origin including the /earn subpath. Used to build share links.
NEXT_PUBLIC_SITE_URL=https://timeglass.ai/earn

# Booking link the VA's superior lands on. The VA's referral code is appended
# as ?ref=<code>.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/timeglass/intro

# --- Supabase (auth + database) -------------------------------------------
# Without these the landing page still ships; signup and dashboard show a
# "not live yet" state instead of erroring.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — required for lead inserts, the booking webhook,
# and payout runs. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- CRM ------------------------------------------------------------------
# OPEN QUESTION (PRD §13): endpoint to be provided. Lead submission works
# without it; leads are stored and `crm_synced_at` stays null.
EARN_CRM_WEBHOOK_URL=
EARN_CRM_WEBHOOK_SECRET=

# --- Inbound webhooks -----------------------------------------------------
# Shared secret for POST /earn/api/bookings (booking tool + CRM attendance).
# Fails closed: unset means every call is rejected.
EARN_BOOKING_WEBHOOK_SECRET=
# Shared secret for POST /earn/api/payouts/run (weekly scheduler).
EARN_PAYOUT_RUN_SECRET=

# --- Payout rails ---------------------------------------------------------
# Unset rails fall back to the manual provider, which queues the payout for a
# human to send rather than failing it.
WISE_API_KEY=
WISE_PROFILE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Analytics ------------------------------------------------------------
# No-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
